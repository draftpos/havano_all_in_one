<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_puremetrix">
        <t t-set="doc_model" t-value="o._name"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        
        <!-- Page Body -->
        <div class="article page" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" style="font-family: 'Aptos Narrow', sans-serif; font-size: 13px; color: #000; width: 100%;">
            
            <!-- Header Image placed in body to prevent cropping by paperformat margins -->
            <div style="width: 100%; margin-top: -10px; margin-bottom: 20px;">
                <img src="/havano_all_in_one/static/src/img/puremetrix_letterhead.png" style="width: 100%; display: block;" alt="Puremetrix Header"/>
            </div>

            <table style="width: 100%; margin-bottom: 10px; border-collapse: collapse;">
                <tr>
                    <td style="width: 60%; vertical-align: top; padding-left: 20px;">
                        <div style="font-weight: bold; margin-bottom: 15px; font-size: 15px;">
                            Customer Name: <span t-field="o.partner_id.name"/>
                        </div>
                        <div style="font-weight: bold; margin-bottom: 5px;">Address, VAT Number, TIN Number</div>
                        <div style="line-height: 1.4;">
                            <span t-field="o.partner_id.street"/>
                            <t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t>
                            <t t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></t>
                            <t t-if="o.partner_id.country_id">, <span t-field="o.partner_id.country_id.name"/></t>
                        </div>
                        <div style="margin-top: 5px;">
                            VAT: <span t-field="o.partner_id.vat" t-options='{"widget": "text", "default": "N/A"}'/>
                        </div>
                        <div>
                            TIN: <span t-field="o.partner_id.company_registry" t-options='{"widget": "text", "default": "N/A"}'/>
                        </div>
                    </td>
                    <td style="width: 40%; vertical-align: top; padding-right: 20px;">
                        <table style="border-collapse: collapse; width: 100%; border: 1px solid #000; font-weight: bold; line-height: 1.5;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px 8px; width: 40%;">
                                    <t t-if="doc_model == 'sale.order'">Quote No:</t>
                                    <t t-else="">Invoice No:</t>
                                </td>
                                <td style="border: 1px solid #000; padding: 4px 8px;"><span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px 8px;">Date:</td>
                                <td style="border: 1px solid #000; padding: 4px 8px;">
                                    <t t-if="doc_model == 'account.move'">
                                        <span t-field="o.invoice_date" t-options='{"widget": "date", "format": "dd MMMM yyyy"}'/>
                                    </t>
                                    <t t-if="doc_model == 'sale.order'">
                                        <span t-field="o.date_order" t-options='{"widget": "date", "format": "dd MMMM yyyy"}'/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px 8px;">VAT NO:</td>
                                <td style="border: 1px solid #000; padding: 4px 8px;">220436044</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px 8px;">TIN NO:</td>
                                <td style="border: 1px solid #000; padding: 4px 8px;">2001117112</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <div style="border-top: 3px solid #000; margin: 15px 0;"></div>

            <div style="font-weight: bold; padding: 0 20px; font-size: 14px;">
                RE: 
                <t t-if="doc_model == 'account.move'">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">SUPPLY OF GOODS / SERVICES (TAX INVOICE)</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">DRAFT INVOICE</span>
                    <span t-if="o.move_type == 'out_refund'">CREDIT NOTE</span>
                    <span t-if="o.move_type == 'in_invoice'">VENDOR BILL</span>
                    <span t-if="o.move_type == 'in_refund'">VENDOR CREDIT NOTE</span>
                </t>
                <t t-if="doc_model == 'sale.order'">
                    <span t-if="o.state not in ['draft','sent']">SUPPLY OF GOODS / SERVICES (SALES ORDER)</span>
                    <span t-if="o.state in ['draft','sent']">SUPPLY OF GOODS / SERVICES (QUOTATION)</span>
                </t>
            </div>

            <div style="padding: 0 20px; margin-top: 15px;">
                <table style="width: 100%; border-collapse: collapse; border: 2px solid #000;">
                    <thead>
                        <tr style="background-color: #ffe699; font-weight: bold;">
                            <th style="border: 1px solid #000; padding: 6px 5px; text-align: center; width: 8%;">Sl. No.</th>
                            <th style="border: 1px solid #000; padding: 6px 5px; text-align: left; width: 47%;">Description</th>
                            <th style="border: 1px solid #000; padding: 6px 5px; text-align: center; width: 10%;">Qty</th>
                            <th style="border: 1px solid #000; padding: 6px 5px; text-align: right; width: 15%;">Price Unit (USD)</th>
                            <th style="border: 1px solid #000; padding: 6px 5px; text-align: right; width: 20%;">Amount (USD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                        <t t-set="line_idx" t-value="1"/>
                        <t t-foreach="lines" t-as="line">
                            <tr t-if="line.display_type in ['product', False, '']">
                                <td style="border: 1px solid #000; padding: 5px; text-align: center; font-weight: bold;">
                                    <span t-esc="line_idx"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: left;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: center;">
                                    <span t-if="doc_model == 'account.move'" t-field="line.quantity"/>
                                    <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: right;">
                                    $ <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 5px; text-align: right;">
                                    $ <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                            <t t-if="line.display_type == 'line_section'">
                                <tr>
                                    <td colspan="5" style="border: 1px solid #000; padding: 5px; font-weight: bold; background-color: #f2f2f2; text-align: left;">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <tr>
                                    <td colspan="5" style="border: 1px solid #000; padding: 5px; font-style: italic; text-align: left;">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="line.display_type in ['product', False, '']">
                                <t t-set="line_idx" t-value="line_idx + 1"/>
                            </t>
                        </t>
                    </tbody>
                </table>

                <table style="width: 100%; border-collapse: collapse; border: 2px solid #000; border-top: none;">
                    <tr>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; width: 80%; background-color: #ffe699; font-weight: bold;">Sub Total</td>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; width: 20%; background-color: #ffe699; font-weight: bold;">
                            $ <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; font-weight: bold;">V.A.T.</td>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right;">
                            $ <span t-field="o.amount_tax" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                    </tr>
                    <!-- Discount line if applicable -->
                    <t t-set="qty_field" t-value="lambda l: l.quantity if doc_model == 'account.move' else l.product_uom_qty"/>
                    <t t-set="total_discount" t-value="sum((l.price_unit * qty_field(l) * (l.discount / 100.0)) for l in lines.filtered(lambda l: l.display_type in ['product', False, '']))"/>
                    <tr t-if="total_discount &gt; 0">
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; font-weight: bold;">Discount</td>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right;">
                            $ <span t-esc="total_discount" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; background-color: #ffe699; font-weight: bold;">Final Amount:</td>
                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; background-color: #ffe699; font-weight: bold;">
                            $ <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/>
                        </td>
                    </tr>
                </table>

                <!-- Bank details -->
                <table style="margin-top: 20px; width: 60%; font-weight: bold; border-collapse: collapse; font-size: 12px; line-height: 1.5;">
                    <tr>
                        <td style="width: 130px; padding: 2px 0;">ACCOUNT NAME</td>
                        <td>: PUREMETRIX ENGINEERING PVT LTD</td>
                    </tr>
                    <tr>
                        <td style="padding: 2px 0;">BANK</td>
                        <td>: ECOBANK</td>
                    </tr>
                    <tr>
                        <td style="padding: 2px 0;">BRANCH</td>
                        <td>: SOUTHERTON</td>
                    </tr>
                    <tr>
                        <td style="padding: 2px 0;">NOSTRO A/C</td>
                        <td>: 5775400008173</td>
                    </tr>
                </table>

                <div style="margin-top: 25px; border: 1px solid #000; width: 45%; padding: 8px; font-size: 11px; float: left; line-height: 1.4;">
                    <div>Quote Prepared by: Melissa Kubvoruno (+263 784 363 722)</div>
                    <div style="margin-top: 3px;">Approved by: Ziviso Mhere (+263 772 294 967)</div>
                </div>

                <div style="clear: both;"></div>

                <div style="margin-top: 35px; text-align: center; width: 100%;">
                    <img src="/havano_all_in_one/static/src/img/puremetrix_logo.png" alt="Logo" style="width: 80px; height: 80px; margin-bottom: 5px;"/>
                    <div style="font-weight: bold; font-size: 11px;">Seal &amp; Signature</div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer" style="width: 100%; border-top: 1px solid #ccc; padding-top: 5px; font-size: 10px; font-family: sans-serif; display: flex; justify-content: space-between;">
            <div>
                Printed on: <span t-esc="datetime.datetime.now().strftime('%Y/%m/%d at %H:%M:%S')"/>
            </div>
            <div>
                Page <span class="page"/> of <span class="topage"/>
            </div>
        </div>
    </template>
</odoo>
