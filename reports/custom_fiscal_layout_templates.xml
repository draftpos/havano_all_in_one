<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_fiscal">
        <t t-set="doc_model" t-value="o._name"/>
        
        <div class="article page" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" style="font-family: Arial, sans-serif; font-size: 13px; width: 100%;">
            
            <!-- Document Title Row -->
            <div style="text-align: center; font-weight: bold; font-size: 20px; margin-bottom: 20px;">
                <t t-if="doc_model == 'account.move'">
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">FISCAL TAX INVOICE</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">DRAFT INVOICE</span>
                    <span t-if="o.move_type == 'out_refund'">CREDIT NOTE</span>
                    <span t-if="o.move_type == 'in_invoice'">VENDOR BILL</span>
                    <span t-if="o.move_type == 'in_refund'">VENDOR CREDIT NOTE</span>
                </t>
                <t t-if="doc_model == 'sale.order'">
                    <span t-if="o.state not in ['draft','sent']">SALES ORDER</span>
                    <span t-if="o.state in ['draft','sent']">QUOTATION</span>
                </t>
            </div>
            
            <!-- Header Details (Company vs Customer) -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                <tr>
                    <!-- Left side: SELLER Details -->
                    <td style="width: 50%; padding: 0; vertical-align: top; padding-right: 15px;">
                        <div style="font-weight: bold; margin-bottom: 5px;">SELLER</div>
                        <div t-field="o.company_id.name"/>
                        <div t-if="o.company_id.company_registry">TIN: <span t-field="o.company_id.company_registry"/></div>
                        <div t-if="o.company_id.vat">VAT No: <span t-field="o.company_id.vat"/></div>
                        <div t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <div t-if="o.company_id.email"><span t-field="o.company_id.email"/></div>
                        <div t-if="o.company_id.phone"><span t-field="o.company_id.phone"/></div>
                    </td>
                    
                    <!-- Right side: BUYER Details -->
                    <td style="width: 50%; padding: 0; vertical-align: top; padding-left: 15px;">
                        <div style="font-weight: bold; margin-bottom: 5px;">BUYER</div>
                        <div t-field="o.partner_id.name"/>
                        
                        <div t-if="o.partner_id.hao_tin">TIN: <span t-field="o.partner_id.hao_tin"/></div>
                        <div t-elif="o.partner_id.company_registry">TIN: <span t-field="o.partner_id.company_registry"/></div>
                        
                        <div t-if="o.partner_id.hao_vat">VAT No: <span t-field="o.partner_id.hao_vat"/></div>
                        <div t-elif="o.partner_id.vat">VAT No: <span t-field="o.partner_id.vat"/></div>
                        
                        <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        <div t-if="o.partner_id.email"><span t-field="o.partner_id.email"/></div>
                        <div t-if="o.partner_id.phone"><span t-field="o.partner_id.phone"/></div>
                    </td>
                </tr>
            </table>

            <div style="border-top: 2px solid black; margin-bottom: 10px;"></div>

            <!-- Metadata Table -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
                <tr>
                    <td style="width: 50%; vertical-align: top; padding-right: 15px;">
                        <div>Invoice No: <span t-field="o.name"/></div>
                        <t t-if="doc_model == 'account.move'">
                            <div t-if="o.ref">Customer Ref No: <span t-field="o.ref"/></div>
                            <div>Seller Invoice: <span t-field="o.name"/></div>
                        </t>
                        <t t-if="doc_model == 'sale.order'">
                            <div t-if="o.client_order_ref">Customer Ref No: <span t-field="o.client_order_ref"/></div>
                        </t>
                    </td>
                    <td style="width: 50%; vertical-align: top; padding-left: 15px;">
                        <t t-if="doc_model == 'account.move'">
                            <div>Date: <span t-field="o.invoice_date"/></div>
                            <div t-if="o.invoice_origin">Ref: <span t-field="o.invoice_origin"/></div>
                        </t>
                        <t t-if="doc_model == 'sale.order'">
                            <div>Date: <span t-field="o.date_order" t-options='{"widget": "date"}'/></div>
                        </t>
                    </td>
                </tr>
            </table>

            <div style="border-top: 2px solid black; margin-bottom: 10px;"></div>

            <!-- Order Lines -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                <thead>
                    <tr style="border-bottom: 1px solid black; font-weight: bold; background-color: #e6e6e6;">
                        <th style="padding: 5px; text-align: left;">Code</th>
                        <th style="padding: 5px; text-align: left;">Description</th>
                        <th style="padding: 5px; text-align: center;">Qty</th>
                        <th style="padding: 5px; text-align: right;">Price</th>
                        <th style="padding: 5px; text-align: right;">Exclusive</th>
                        <th style="padding: 5px; text-align: right;">VAT</th>
                        <th style="padding: 5px; text-align: right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                    <tr t-foreach="lines" t-as="line" style="border-bottom: 1px solid transparent;">
                        <t t-if="line.display_type in ['product', False, '']">
                            <td style="padding: 5px; vertical-align: top;">
                                <span t-field="line.product_id.default_code"/>
                            </td>
                            <td style="padding: 5px; vertical-align: top;">
                                <span t-field="line.name"/>
                            </td>
                            <td style="padding: 5px; text-align: center; vertical-align: top;">
                                <span t-if="doc_model == 'account.move'" t-field="line.quantity" t-options='{"widget": "float", "precision": 2}'/>
                                <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            
                            <!-- Price -->
                            <td style="padding: 5px; text-align: right; vertical-align: top;">
                                <span t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            
                            <!-- Exclusive -->
                            <td style="padding: 5px; text-align: right; vertical-align: top;">
                                <span t-esc="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            
                            <!-- VAT amount for this line -->
                            <t t-set="qty" t-value="line.quantity if doc_model == 'account.move' else line.product_uom_qty"/>
                            <t t-set="line_taxes" t-value="line.tax_ids"/>
                            <t t-set="taxes" t-value="line_taxes.compute_all(line.price_unit, o.currency_id, qty, product=line.product_id, partner=o.partner_id)"/>
                            <t t-set="vat_amount" t-value="taxes['total_included'] - taxes['total_excluded']"/>
                            <td style="padding: 5px; text-align: right; vertical-align: top;">
                                <span t-esc="vat_amount" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                            
                            <!-- Total -->
                            <td style="padding: 5px; text-align: right; vertical-align: top;">
                                <span t-esc="taxes['total_included']" t-options='{"widget": "float", "precision": 2}'/>
                            </td>
                        </t>
                        <t t-if="line.display_type == 'line_section'">
                            <td colspan="7" style="padding: 5px; font-weight: bold; background-color: #f2f2f2;">
                                <span t-field="line.name"/>
                            </td>
                        </t>
                        <t t-if="line.display_type == 'line_note'">
                            <td colspan="7" style="padding: 5px; font-style: italic;">
                                <span t-field="line.name"/>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>

            <!-- Totals -->
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;"></td>
                    <td style="width: 50%;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="padding: 5px 10px; width: 60%;">Total (excl. vat)</td>
                                <td style="padding: 5px 10px; text-align: right; width: 40%;">
                                    <span t-if="doc_model == 'account.move'" t-field="o.amount_untaxed"/>
                                    <span t-if="doc_model == 'sale.order'" t-field="o.amount_untaxed"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 5px 10px;">VAT</td>
                                <td style="padding: 5px 10px; text-align: right;">
                                    <span t-if="doc_model == 'account.move'" t-field="o.amount_tax"/>
                                    <span t-if="doc_model == 'sale.order'" t-field="o.amount_tax"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 5px 10px; font-weight: bold;">Invoice Total, <span t-field="o.currency_id.name"/></td>
                                <td style="padding: 5px 10px; text-align: right; font-weight: bold;">
                                    <span t-if="doc_model == 'account.move'" t-field="o.amount_total"/>
                                    <span t-if="doc_model == 'sale.order'" t-field="o.amount_total"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <div style="page-break-inside: avoid;">
                <!-- Banking Details -->
                <div t-if="o.company_id.hao_bank_detail_ids" style="margin-top: 40px; font-family: Arial, sans-serif; font-size: 13px;">
                    <div style="font-weight: bold; margin-bottom: 15px; font-size: 14px; text-transform: uppercase;">
                        BANKING DETAILS
                    </div>
                    
                    <t t-foreach="o.company_id.hao_bank_detail_ids" t-as="bank">
                        <div style="margin-bottom: 20px;">
                            <div t-if="bank.bank_id"><span style="font-weight: bold;">Bank:</span> <span t-field="bank.bank_id.name"/></div>
                            <div t-if="bank.acc_holder_name"><span style="font-weight: bold;">Name:</span> <span t-field="bank.acc_holder_name"/></div>
                            <div t-if="bank.branch_name"><span style="font-weight: bold;">Branch:</span> <span t-field="bank.branch_name"/></div>
                            <div t-if="bank.acc_number"><span style="font-weight: bold;">Nostro Account Number:</span> <span t-field="bank.acc_number"/></div>
                        </div>
                    </t>
                </div>
            </div>

        </div>
    </template>
</odoo>
