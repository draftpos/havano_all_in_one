<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_showline">
        <t t-set="doc_model" t-value="o._name"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="theme_color" t-value="'#0a1c40'"/>

        <style><![CDATA[
            @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');
            
            .showline-wrap {
                font-family: 'Montserrat', Arial, sans-serif !important;
                font-size: 10.5px;
                color: #2d3748;
                width: 100%;
                margin: 0;
                padding: 0;
            }
            .showline-wrap * {
                font-family: 'Montserrat', Arial, sans-serif !important;
            }

            /* GLOBAL RESET: Strip all default table/cell borders */
            .showline-wrap table,
            .showline-wrap tbody,
            .showline-wrap thead,
            .showline-wrap tr,
            .showline-wrap td,
            .showline-wrap th {
                border: 0 !important;
                border-top: 0 !important;
                border-bottom: 0 !important;
                border-left: 0 !important;
                border-right: 0 !important;
                box-shadow: none !important;
            }

            /* Document Title */
            .sl-title-banner {
                text-align: center;
                font-size: 26px;
                font-weight: 900;
                letter-spacing: 8px;
                color: #0a1c40;
                padding: 4px 0 2px 0;
                text-transform: uppercase;
            }
            .sl-title-divider {
                height: 3px;
                background: linear-gradient(to right, #0a1c40, #3182ce, #e2e8f0);
                border-radius: 2px;
                margin: 4px 0 16px 0;
            }

            /* Company Details */
            .sl-company-name {
                font-size: 15px;
                font-weight: 800;
                color: #0a1c40;
                text-transform: uppercase;
                letter-spacing: 1.2px;
                margin-bottom: 4px;
            }
            .sl-company-detail {
                font-size: 9.5px;
                font-weight: 500;
                color: #4a5568;
                line-height: 1.6;
            }
            .sl-company-detail i {
                color: #0a1c40;
                font-weight: 700;
                margin-right: 4px;
                width: 11px;
                display: inline-block;
            }

            /* Registration Box */
            .sl-reg-card {
                background: #f7fafc;
                border-radius: 6px;
                padding: 8px 12px;
                display: inline-block;
                text-align: left;
                min-width: 170px;
                border: 1px solid #e2e8f0 !important;
            }
            .sl-reg-title {
                font-size: 8.5px;
                font-weight: 800;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: #0a1c40;
                margin-bottom: 5px;
                padding-bottom: 3px;
                border-bottom: 1px solid #cbd5e0 !important;
            }
            .sl-reg-row {
                font-size: 9.5px;
                margin-bottom: 2px;
            }
            .sl-reg-label {
                font-weight: 800;
                color: #0a1c40;
                margin-right: 6px;
            }
            .sl-reg-val {
                font-weight: 600;
                color: #4a5568;
            }

            /* Info Card (Customer & Invoice Details) */
            .sl-info-card {
                border-radius: 6px;
                overflow: hidden;
                background: #fff;
                border: 1px solid #e2e8f0 !important;
            }
            .sl-info-header {
                background: #0a1c40;
                color: #ffffff !important;
                font-weight: 700;
                padding: 6px 12px;
                font-size: 10.5px;
                letter-spacing: 0.5px;
            }
            .sl-info-body td {
                padding: 5px 12px !important;
                font-size: 9.5px;
            }
            .sl-info-label {
                font-weight: 700;
                color: #4a5568;
                width: 35%;
            }
            .sl-info-value {
                color: #1a202c;
                font-weight: 500;
            }
            .sl-row-alt {
                background: #f8fafc;
            }

            /* Product Items Table */
            .sl-table {
                width: 100%;
                border-collapse: collapse;
                border-radius: 6px;
                overflow: hidden;
                border: 1px solid #e2e8f0 !important;
                margin-bottom: 16px;
            }
            .sl-table thead tr {
                background-color: #0a1c40;
                color: #ffffff !important;
            }
            .sl-table thead th {
                padding: 8px 10px !important;
                font-weight: 700;
                font-size: 10px;
                letter-spacing: 0.5px;
                color: #ffffff !important;
            }
            .sl-table tbody td {
                padding: 8px 10px !important;
                font-size: 9.5px;
                border-bottom: 1px solid #edf2f7 !important;
            }

            /* Rich-text description formatting */
            .sl-line-desc ul, .sl-line-desc ol {
                margin: 2px 0 2px 14px;
                padding: 0;
            }
            .sl-line-desc li {
                margin-bottom: 1px;
                list-style-type: disc;
            }
            .sl-line-desc ol li {
                list-style-type: decimal;
            }
            .sl-line-desc p {
                margin: 1px 0;
            }
            .sl-line-desc strong, .sl-line-desc b {
                font-weight: 700;
            }
            .sl-line-desc em, .sl-line-desc i {
                font-style: italic;
            }

            /* Totals Card */
            .sl-totals-card {
                border-radius: 6px;
                overflow: hidden;
                border: 1px solid #e2e8f0 !important;
            }
            .sl-totals-card td {
                padding: 6px 12px !important;
                font-size: 10px;
                border-bottom: 1px solid #edf2f7 !important;
            }
            .sl-totals-grand {
                background: #0a1c40 !important;
                color: #ffffff !important;
                font-weight: 800 !important;
                font-size: 11.5px !important;
            }
            .sl-totals-grand td {
                color: #ffffff !important;
                border-bottom: none !important;
                padding: 8px 12px !important;
            }

            /* Terms & Bank Box */
            .sl-box-card {
                border-radius: 6px;
                overflow: hidden;
                border: 1px solid #e2e8f0 !important;
            }
            .sl-box-header {
                padding: 6px 12px;
                font-weight: 700;
                font-size: 10.5px;
                color: #0a1c40;
                background: #f7fafc;
                border-bottom: 2px solid #0a1c40 !important;
            }
            .sl-box-body {
                padding: 10px 14px;
                font-size: 9.5px;
                color: #4a5568;
                min-height: 60px;
            }
        ]]></style>

        <div class="article page showline-wrap" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- HEADER ROW 1: Centered Document Title                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div class="sl-title-banner">
                <span style="font-size: 16px; opacity: 0.4; letter-spacing: 2px; margin-right: 8px;">&#9472;&#9472;</span>
                <t t-if="doc_model == 'sale.order'">
                    <t t-if="is_pro_forma">PRO-FORMA</t>
                    <t t-elif="o.state in ['draft', 'sent']">QUOTATION</t>
                    <t t-else="">SALES ORDER</t>
                </t>
                <t t-if="doc_model == 'account.move'">
                    <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">INVOICE</t>
                    <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">DRAFT INVOICE</t>
                    <t t-elif="o.move_type == 'out_refund'">CREDIT NOTE</t>
                    <t t-elif="o.move_type == 'in_invoice'">VENDOR BILL</t>
                    <t t-elif="o.move_type == 'in_refund'">VENDOR CREDIT NOTE</t>
                    <t t-else="">DOCUMENT</t>
                </t>
                <span style="font-size: 16px; opacity: 0.4; letter-spacing: 2px; margin-left: 8px;">&#9472;&#9472;</span>
            </div>

            <!-- Gradient Accent Divider -->
            <div class="sl-title-divider"/>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- HEADER ROW 2: Logo + Company Details + Registration       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <table style="width: 100%; margin-bottom: 16px;">
                <tr>
                    <!-- LEFT: Logo -->
                    <td style="width: 16%; vertical-align: top; padding-right: 12px;">
                        <t t-if="company.logo">
                            <img t-att-src="'/web/image/res.company/%s/logo' % company.id"
                                 style="max-height: 70px; max-width: 120px; object-fit: contain;"/>
                        </t>
                    </td>

                    <!-- MIDDLE: Company Details -->
                    <td style="width: 54%; vertical-align: top;">
                        <div class="sl-company-name">
                            <span t-field="company.name"/>
                        </div>
                        <div class="sl-company-detail">
                            <t t-if="company.street">
                                <div>
                                    <i class="fa fa-map-marker"/>
                                    <span t-field="company.street"/><t t-if="company.street2">, <span t-field="company.street2"/></t><t t-if="company.city">, <span t-field="company.city"/></t><t t-if="company.state_id">, <span t-field="company.state_id.name"/></t><t t-if="company.country_id">, <span t-field="company.country_id.name"/></t>
                                </div>
                            </t>
                            <t t-if="company.phone">
                                <div><i class="fa fa-phone"/><span t-field="company.phone"/></div>
                            </t>
                            <t t-if="company.email">
                                <div><i class="fa fa-envelope-o"/><span t-field="company.email"/></div>
                            </t>
                            <t t-if="company.website">
                                <div><i class="fa fa-globe"/><span t-field="company.website"/></div>
                            </t>
                        </div>
                    </td>

                    <!-- RIGHT: Registration Card -->
                    <td style="width: 30%; vertical-align: top; text-align: right;">
                        <div class="sl-reg-card">
                            <div class="sl-reg-title">Company Registration</div>
                            <div class="sl-reg-row">
                                <span class="sl-reg-label">TIN:</span>
                                <span class="sl-reg-val"><t t-esc="company.company_registry or 'N/A'"/></span>
                            </div>
                            <div class="sl-reg-row">
                                <span class="sl-reg-label">VAT:</span>
                                <span class="sl-reg-val"><t t-esc="company.vat or 'N/A'"/></span>
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- DETAILS ROW: Customer + Invoice Info                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <table style="width: 100%; margin-bottom: 16px;">
                <tr>
                    <!-- CUSTOMER DETAILS CARD -->
                    <td style="width: 48%; vertical-align: top;">
                        <div class="sl-info-card">
                            <div class="sl-info-header">
                                <i class="fa fa-user" style="margin-right: 6px;"/> CUSTOMER DETAILS
                            </div>
                            <table style="width: 100%;" class="sl-info-body">
                                <tr class="sl-row-alt">
                                    <td class="sl-info-label">Customer</td>
                                    <td class="sl-info-value" style="font-weight: 700;"><span t-field="partner.name"/></td>
                                </tr>
                                <tr>
                                    <td class="sl-info-label">Address</td>
                                    <td class="sl-info-value">
                                        <span t-if="partner.street" t-field="partner.street"/>
                                        <span t-if="partner.street2">, <span t-field="partner.street2"/></span>
                                        <span t-if="partner.city">, <span t-field="partner.city"/></span>
                                        <span t-if="partner.country_id">, <span t-field="partner.country_id.name"/></span>
                                    </td>
                                </tr>
                                <tr class="sl-row-alt">
                                    <td class="sl-info-label">Phone</td>
                                    <td class="sl-info-value"><span t-esc="partner.phone or 'N/A'"/></td>
                                </tr>
                                <tr>
                                    <td class="sl-info-label">VAT / TIN</td>
                                    <td class="sl-info-value"><span t-esc="partner.vat or 'N/A'"/></td>
                                </tr>
                            </table>
                        </div>
                    </td>

                    <td style="width: 4%;"/>

                    <!-- INVOICE / ORDER DETAILS CARD -->
                    <td style="width: 48%; vertical-align: top;">
                        <div class="sl-info-card">
                            <div class="sl-info-header">
                                <i class="fa fa-file-text-o" style="margin-right: 6px;"/>
                                <t t-if="doc_model == 'sale.order'">ORDER DETAILS</t>
                                <t t-else="">INVOICE DETAILS</t>
                            </div>
                            <table style="width: 100%;" class="sl-info-body">
                                <tr class="sl-row-alt">
                                    <td class="sl-info-label">
                                        <t t-if="doc_model == 'sale.order'">Order No.</t>
                                        <t t-else="">Invoice No.</t>
                                    </td>
                                    <td class="sl-info-value" style="font-weight: 700; color: #0a1c40;"><span t-field="o.name"/></td>
                                </tr>
                                <tr>
                                    <td class="sl-info-label">Date</td>
                                    <td class="sl-info-value">
                                        <t t-if="doc_model == 'sale.order'"><span t-field="o.date_order" t-options='{"widget": "date"}'/></t>
                                        <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date" t-options='{"widget": "date"}'/></t>
                                    </td>
                                </tr>
                                <tr class="sl-row-alt">
                                    <td class="sl-info-label">Currency</td>
                                    <td class="sl-info-value"><span t-field="o.currency_id.name"/></td>
                                </tr>
                                <tr>
                                    <td class="sl-info-label">
                                        <t t-if="doc_model == 'sale.order'">Salesperson</t>
                                        <t t-else="">Due Date</t>
                                    </td>
                                    <td class="sl-info-value">
                                        <t t-if="doc_model == 'sale.order'"><span t-field="o.user_id.name"/></t>
                                        <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date_due" t-options='{"widget": "date"}'/></t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- LINES TABLE (No vertical cell dividers, clean rows)        -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <table class="sl-table">
                <thead>
                    <tr>
                        <th style="text-align: center; width: 5%;">#</th>
                        <th style="text-align: left; width: 45%;">Description</th>
                        <th style="text-align: center; width: 10%;">Qty</th>
                        <th style="text-align: right; width: 14%;">Unit Price (<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="text-align: right; width: 12%;">Tax Amt (<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="text-align: right; width: 14%;">Total Amt (<span t-field="o.currency_id.symbol"/>)</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                    <t t-set="line_count" t-value="1"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type in ['product', False, '']">
                            <tr t-attf-style="background: {{ '#f8fafc' if line_index % 2 == 0 else '#ffffff' }};">
                                <td style="text-align: center; font-weight: 700; color: #0a1c40; vertical-align: top;">
                                    <span t-esc="line_count"/>
                                    <t t-set="line_count" t-value="line_count + 1"/>
                                </td>
                                <td style="text-align: left; vertical-align: top;">
                                    <!-- Render HTML if present, otherwise convert plain-text newlines to <br/> -->
                                    <t t-if="'&lt;' in (line.name or '')">
                                        <div class="sl-line-desc" t-out="line.name"/>
                                    </t>
                                    <t t-else="">
                                        <div class="sl-line-desc">
                                            <t t-foreach="(line.name or '').split('\n')" t-as="ln">
                                                <span t-esc="ln"/><br t-if="not ln_last"/>
                                            </t>
                                        </div>
                                    </t>
                                </td>
                                <td style="text-align: center; vertical-align: top; font-weight: 600;">
                                    <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 1}'/>
                                    <span t-if="doc_model == 'account.move'" t-field="line.quantity" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                                <td style="text-align: right; vertical-align: top;">
                                    <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="text-align: right; vertical-align: top;">
                                    <t t-set="tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                    <span t-esc="tax_amt" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="text-align: right; vertical-align: top; font-weight: 700; color: #0a1c40;">
                                    <span t-field="line.price_total" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- TOTALS ROW                                                 -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <table style="width: 100%; margin-bottom: 20px;">
                <tr>
                    <td style="width: 50%;"/>
                    <td style="width: 50%;">
                        <div class="sl-totals-card">
                            <table style="width: 100%;">
                                <tr class="sl-row-alt">
                                    <td style="text-align: right; font-weight: 600; width: 55%; color: #4a5568;">SUBTOTAL (Excl. Tax)</td>
                                    <td style="text-align: right; font-weight: 600;">
                                        <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align: right; font-weight: 600; color: #4a5568;">TOTAL TAX</td>
                                    <td style="text-align: right; font-weight: 600;">
                                        <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="sl-totals-grand">
                                    <td style="text-align: right; letter-spacing: 0.5px;">TOTAL (Incl. Tax)</td>
                                    <td style="text-align: right;">
                                        <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- TERMS AND BANKING ROW                                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <table style="width: 100%; margin-bottom: 20px;">
                <tr>
                    <!-- TERMS -->
                    <td style="width: 48%; vertical-align: top;">
                        <div class="sl-box-card">
                            <div class="sl-box-header">
                                <i class="fa fa-file-text-o"/> TERMS &amp; CONDITIONS
                            </div>
                            <div class="sl-box-body">
                                <div t-if="doc_model == 'sale.order' and o.note" t-field="o.note"/>
                                <div t-if="doc_model == 'account.move' and o.narration" t-field="o.narration"/>
                            </div>
                            <div style="padding: 6px 14px 10px; border-top: 1px dashed #cbd5e0; font-size: 9.5px; color: #718096;">
                                ------------------------------------<br/>
                                <strong>Authorised Signatory</strong><br/>
                                <span t-field="company.name" style="text-transform: uppercase; font-weight: 600;"/>
                            </div>
                        </div>
                    </td>

                    <td style="width: 4%;"/>

                    <!-- BANKING -->
                    <td style="width: 48%; vertical-align: top;">
                        <div class="sl-box-card">
                            <div class="sl-box-header">
                                <i class="fa fa-university"/> BANKING DETAILS
                            </div>
                            <div class="sl-box-body">
                                <t t-if="company.hao_bank_name or company.hao_bank_detail_ids">
                                    <t t-if="company.hao_multi_bank and company.hao_bank_detail_ids">
                                        <t t-foreach="company.hao_bank_detail_ids" t-as="bank">
                                            <div style="margin-bottom: 4px; color: #1a202c;">
                                                <i class="fa fa-bank" style="margin-right:4px; color:#0a1c40;"/>
                                                <span t-field="bank.bank_name"/> — Acc: <strong><span t-field="bank.acc_number"/></strong>
                                                <span t-if="bank.branch"> (<span t-field="bank.branch"/>)</span>
                                            </div>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <div t-if="company.hao_bank_name" style="margin-bottom:3px;"><strong>Bank:</strong> <span t-field="company.hao_bank_name"/></div>
                                        <div t-if="company.hao_bank_account_name" style="margin-bottom:3px;"><strong>Account Name:</strong> <span t-field="company.hao_bank_account_name"/></div>
                                        <div t-if="company.hao_bank_account_no"><strong>Account No:</strong> <span t-field="company.hao_bank_account_no"/></div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <span style="color:#a0aec0; font-style:italic;">No banking details provided.</span>
                                </t>
                            </div>
                            <div style="padding: 6px 14px 10px; border-top: 1px dashed #cbd5e0; text-align: left; font-weight: 600; font-size: 10.5px; color: #0a1c40;">
                                <i style="background-color: #0a1c40; color: white; border-radius: 50%; padding: 3px 4px; margin-right: 4px;" class="fa fa-handshake-o"/>
                                Thank you for your business!
                            </div>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- FOOTER                                                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div style="background: linear-gradient(to right, #0a1c40, #1a365d); color: white; text-align: center; padding: 8px; font-size: 9.5px; border-radius: 4px; letter-spacing: 0.8px;">
                <i class="fa fa-bolt" style="margin-right: 4px;"/> Powered by <strong>HavanoERP</strong>
                <t t-if="company.website"> &amp;nbsp;|&amp;nbsp; <span t-field="company.website"/></t>
            </div>

        </div>
    </template>
</odoo>
