<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_showline">
        <t t-set="doc_model" t-value="o._name"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="theme_color" t-value="'#0a1c40'"/>

        <div class="article page showline-wrap" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 11px; color: #1f2937; width: 100%; margin: 0; padding: 0;">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- HEADER ROW 1: Centered Document Title                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div t-attf-style="text-align: center; font-size: 24px; font-weight: 700; letter-spacing: 5px; color: {{ theme_color }}; padding: 4px 0 2px 0; text-transform: uppercase;">
                <span style="font-size: 15px; opacity: 0.35; letter-spacing: 2px; margin-right: 10px;">&#9472;&#9472;</span>
                <t t-if="doc_model == 'sale.order'">
                    <t t-if="is_pro_forma">PRO-FORMA</t>
                    <t t-elif="o.state in ['draft', 'sent']">QUOTATION</t>
                    <t t-else="">SALES ORDER</t>
                </t>
                <t t-if="doc_model == 'account.move'">
                    <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">INVOICE</t>
                    <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">DRAFT INVOICE</t>
                    <t t-elif="o.move_type == 'out_refund'">CREDIT NOTE</t>
                    <t t-elif="o.move_type == 'in_invoice'">VENDOR BILL</t>
                    <t t-elif="o.move_type == 'in_refund'">VENDOR CREDIT NOTE</t>
                    <t t-else="">DOCUMENT</t>
                </t>
                <span style="font-size: 15px; opacity: 0.35; letter-spacing: 2px; margin-left: 10px;">&#9472;&#9472;</span>
            </div>

            <!-- Accent divider line under title -->
            <div t-attf-style="height: 2.5px; background-color: {{ theme_color }}; margin: 4px 0 16px 0;"/>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- HEADER ROW 2: Company Header & Metadata                    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div style="width: 100%; margin-bottom: 16px; overflow: hidden; clear: both;">
                <!-- LEFT: Logo -->
                <div style="float: left; width: 17%; text-align: left;">
                    <t t-if="company.logo">
                        <img t-att-src="'/web/image/res.company/%s/logo' % company.id"
                             style="max-height: 70px; max-width: 120px; object-fit: contain;"/>
                    </t>
                </div>

                <!-- MIDDLE: Company Information -->
                <div style="float: left; width: 51%; padding-left: 10px;">
                    <div t-attf-style="font-size: 16px; font-weight: 700; color: {{ theme_color }}; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                        <span t-field="company.name"/>
                    </div>
                    <div style="font-size: 11px; font-weight: 400; color: #374151; line-height: 1.55;">
                        <t t-if="company.street">
                            <div>
                                <span t-field="company.street"/><t t-if="company.street2">, <span t-field="company.street2"/></t><t t-if="company.city">, <span t-field="company.city"/></t><t t-if="company.state_id">, <span t-field="company.state_id.name"/></t><t t-if="company.country_id">, <span t-field="company.country_id.name"/></t>
                            </div>
                        </t>
                        <t t-if="company.phone">
                            <div>Tel: <span t-field="company.phone"/></div>
                        </t>
                        <t t-if="company.email">
                            <div>Email: <span t-field="company.email"/></div>
                        </t>
                        <t t-if="company.website">
                            <div>Web: <span t-field="company.website"/></div>
                        </t>
                    </div>
                </div>

                <!-- RIGHT: Company Registration & Tax Metadata (Integrated, No Card) -->
                <div style="float: right; width: 32%; text-align: right; font-size: 11px; line-height: 1.65; color: #374151; padding-top: 2px;">
                    <div t-if="company.company_registry">
                        <span style="color: #4b5563; font-weight: 500;">Registration No:</span>
                        <span style="font-weight: 600; color: #111827; margin-left: 5px;"><t t-esc="company.company_registry"/></span>
                    </div>
                    <div t-if="company.vat">
                        <span style="color: #4b5563; font-weight: 500;">VAT No:</span>
                        <span style="font-weight: 600; color: #111827; margin-left: 5px;"><t t-esc="company.vat"/></span>
                    </div>
                </div>
            </div>

            <!-- Subtle Section Divider -->
            <div style="height: 1px; background-color: #e5e7eb; margin-bottom: 16px; clear: both;"/>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- DETAILS ROW: Customer + Invoice Info                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div style="width: 100%; margin-bottom: 16px; overflow: hidden; clear: both;">
                <!-- CUSTOMER DETAILS -->
                <div style="float: left; width: 48%;">
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db; overflow: hidden;">
                        <tr>
                            <td colspan="2" t-attf-style="background-color: {{ theme_color }}; color: #ffffff; font-weight: 600; padding: 6px 12px; font-size: 11.5px; letter-spacing: 0.4px; border: 0 !important;">
                                <i class="fa fa-user" style="margin-right: 6px;"/> CUSTOMER DETAILS
                            </td>
                        </tr>
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="font-weight: 500; padding: 5px 12px; width: 30%; color: #4b5563; font-size: 11px; border: 0 !important;">Customer</td>
                            <td style="padding: 5px 12px; font-weight: 600; color: #111827; font-size: 12px; border: 0 !important;"><span t-field="partner.name"/></td>
                        </tr>
                        <tr style="background: #ffffff; border-bottom: 1px solid #e5e7eb;">
                            <td style="font-weight: 500; padding: 5px 12px; color: #4b5563; font-size: 11px; border: 0 !important;">Address</td>
                            <td style="padding: 5px 12px; color: #374151; font-size: 11.5px; border: 0 !important;">
                                <span t-if="partner.street" t-field="partner.street"/>
                                <span t-if="partner.street2">, <span t-field="partner.street2"/></span>
                                <span t-if="partner.city">, <span t-field="partner.city"/></span>
                                <span t-if="partner.country_id">, <span t-field="partner.country_id.name"/></span>
                            </td>
                        </tr>
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="font-weight: 500; padding: 5px 12px; color: #4b5563; font-size: 11px; border: 0 !important;">Phone</td>
                            <td style="padding: 5px 12px; color: #111827; font-size: 11.5px; border: 0 !important;"><span t-esc="partner.phone or 'N/A'"/></td>
                        </tr>
                        <tr style="background: #ffffff;">
                            <td style="font-weight: 500; padding: 5px 12px; color: #4b5563; font-size: 11px; border: 0 !important;">VAT / TIN</td>
                            <td style="padding: 5px 12px; color: #111827; font-size: 11.5px; border: 0 !important;"><span t-esc="partner.vat or 'N/A'"/></td>
                        </tr>
                    </table>
                </div>

                <!-- INVOICE / ORDER DETAILS -->
                <div style="float: right; width: 48%;">
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db; overflow: hidden;">
                        <tr>
                            <td colspan="2" t-attf-style="background-color: {{ theme_color }}; color: #ffffff; font-weight: 600; padding: 6px 12px; font-size: 11.5px; letter-spacing: 0.4px; border: 0 !important;">
                                <i class="fa fa-file-text-o" style="margin-right: 6px;"/>
                                <t t-if="doc_model == 'sale.order'">ORDER DETAILS</t>
                                <t t-else="">INVOICE DETAILS</t>
                            </td>
                        </tr>
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="font-weight: 500; padding: 5px 12px; width: 34%; color: #4b5563; font-size: 11px; border: 0 !important;">
                                <t t-if="doc_model == 'sale.order'">Order No.</t>
                                <t t-else="">Invoice No.</t>
                            </td>
                            <td t-attf-style="padding: 5px 12px; font-weight: 700; color: {{ theme_color }}; font-size: 12px; border: 0 !important;"><span t-field="o.name"/></td>
                        </tr>
                        <tr style="background: #ffffff; border-bottom: 1px solid #e5e7eb;">
                            <td style="font-weight: 500; padding: 5px 12px; color: #4b5563; font-size: 11px; border: 0 !important;">Date</td>
                            <td style="padding: 5px 12px; color: #111827; font-size: 11.5px; border: 0 !important;">
                                <t t-if="doc_model == 'sale.order'"><span t-field="o.date_order" t-options='{"widget": "date"}'/></t>
                                <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date" t-options='{"widget": "date"}'/></t>
                            </td>
                        </tr>
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="font-weight: 500; padding: 5px 12px; color: #4b5563; font-size: 11px; border: 0 !important;">Currency</td>
                            <td style="padding: 5px 12px; color: #111827; font-size: 11.5px; border: 0 !important;"><span t-field="o.currency_id.name"/></td>
                        </tr>
                        <tr style="background: #ffffff;">
                            <td style="font-weight: 500; padding: 5px 12px; color: #4b5563; font-size: 11px; border: 0 !important;">
                                <t t-if="doc_model == 'sale.order'">Salesperson</t>
                                <t t-else="">Due Date</t>
                            </td>
                            <td style="padding: 5px 12px; color: #111827; font-size: 11.5px; border: 0 !important;">
                                <t t-if="doc_model == 'sale.order'"><span t-field="o.user_id.name"/></t>
                                <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date_due" t-options='{"widget": "date"}'/></t>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- LINES TABLE                                                -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db; margin-bottom: 16px; overflow: hidden; clear: both;">
                <thead>
                    <tr t-attf-style="background-color: {{ theme_color }}; color: #ffffff; font-weight: 600; font-size: 11px;">
                        <th style="padding: 8px 6px; text-align: center; width: 5%; color: #ffffff; border: 0 !important;">#</th>
                        <th style="padding: 8px 10px; text-align: left; width: 45%; color: #ffffff; border: 0 !important;">Description</th>
                        <th style="padding: 8px 6px; text-align: center; width: 10%; color: #ffffff; border: 0 !important;">Qty</th>
                        <th style="padding: 8px 10px; text-align: right; width: 14%; color: #ffffff; border: 0 !important;">Unit Price (<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="padding: 8px 10px; text-align: right; width: 12%; color: #ffffff; border: 0 !important;">Tax Amt (<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="padding: 8px 10px; text-align: right; width: 14%; color: #ffffff; border: 0 !important;">Total Amt (<span t-field="o.currency_id.symbol"/>)</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                    <t t-set="line_count" t-value="1"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type in ['product', False, '']">
                            <tr t-attf-style="border-bottom: 1px solid #e5e7eb; background: {{ '#f9fafb' if line_index % 2 == 0 else '#ffffff' }};">
                                <td t-attf-style="padding: 8px 6px; text-align: center; font-weight: 600; font-size: 11px; color: {{ theme_color }}; vertical-align: top; border: 0 !important;">
                                    <span t-esc="line_count"/>
                                    <t t-set="line_count" t-value="line_count + 1"/>
                                </td>
                                <td style="padding: 8px 10px; text-align: left; vertical-align: top; border: 0 !important;">
                                    <!-- Bullet points / HTML formatted description -->
                                    <t t-if="'&lt;' in (line.name or '')">
                                        <div style="line-height: 1.5; font-size: 11px; color: #1f2937;" t-out="line.name"/>
                                    </t>
                                    <t t-else="">
                                        <div style="line-height: 1.5; font-size: 11px; color: #1f2937;">
                                            <t t-foreach="(line.name or '').split('\n')" t-as="ln">
                                                <span t-esc="ln"/><br t-if="not ln_last"/>
                                            </t>
                                        </div>
                                    </t>
                                </td>
                                <td style="padding: 8px 6px; text-align: center; vertical-align: top; font-weight: 500; font-size: 11.5px; color: #111827; border: 0 !important;">
                                    <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 1}'/>
                                    <span t-if="doc_model == 'account.move'" t-field="line.quantity" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                                <td style="padding: 8px 10px; text-align: right; vertical-align: top; font-weight: 400; font-size: 11.5px; color: #111827; border: 0 !important;">
                                    <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="padding: 8px 10px; text-align: right; vertical-align: top; font-weight: 400; font-size: 11.5px; color: #111827; border: 0 !important;">
                                    <t t-set="tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                    <span t-esc="tax_amt" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td t-attf-style="padding: 8px 10px; text-align: right; vertical-align: top; font-weight: 600; font-size: 11.5px; color: {{ theme_color }}; border: 0 !important;">
                                    <span t-field="line.price_total" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- TOTALS ROW                                                 -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div style="width: 100%; margin-bottom: 18px; overflow: hidden; clear: both;">
                <div style="float: right; width: 48%;">
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #d1d5db; overflow: hidden;">
                        <tr style="background: #f9fafb; border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 7px 14px; text-align: right; font-weight: 500; width: 55%; color: #4b5563; font-size: 11px; border: 0 !important;">SUBTOTAL (Excl. Tax)</td>
                            <td style="padding: 7px 14px; text-align: right; font-weight: 500; color: #111827; font-size: 11.5px; border: 0 !important;">
                                <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr style="background: #ffffff; border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 7px 14px; text-align: right; font-weight: 500; color: #4b5563; font-size: 11px; border: 0 !important;">TOTAL TAX</td>
                            <td style="padding: 7px 14px; text-align: right; font-weight: 500; color: #111827; font-size: 11.5px; border: 0 !important;">
                                <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr t-attf-style="background-color: {{ theme_color }}; color: #ffffff;">
                            <td style="padding: 9px 14px; text-align: right; font-weight: 600; font-size: 12px; color: #ffffff; border: 0 !important;">TOTAL (Incl. Tax)</td>
                            <td style="padding: 9px 14px; text-align: right; font-weight: 700; font-size: 13.5px; color: #ffffff; border: 0 !important;">
                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- TERMS AND BANKING ROW                                      -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div style="width: 100%; margin-bottom: 18px; overflow: hidden; clear: both;">
                <!-- TERMS -->
                <div style="float: left; width: 48%; border: 1px solid #d1d5db; overflow: hidden; box-sizing: border-box;">
                    <div t-attf-style="padding: 6px 12px; font-weight: 600; border-bottom: 2px solid {{ theme_color }}; color: {{ theme_color }}; font-size: 11px; background: #f9fafb;">
                        <i class="fa fa-file-text-o"/> TERMS &amp; CONDITIONS
                    </div>
                    <div style="padding: 10px 14px; min-height: 60px; color: #374151; font-size: 10px; line-height: 1.55;">
                        <div t-if="doc_model == 'sale.order' and o.note" t-field="o.note"/>
                        <div t-if="doc_model == 'account.move' and o.narration" t-field="o.narration"/>
                    </div>
                    <div style="padding: 6px 14px 10px; border-top: 1px dashed #d1d5db; font-size: 10px; color: #6b7280;">
                        ------------------------------------<br/>
                        <strong>Authorised Signatory</strong><br/>
                        <span t-field="company.name" style="text-transform: uppercase; font-weight: 600; color: #111827;"/>
                    </div>
                </div>

                <!-- BANKING -->
                <div style="float: right; width: 48%; border: 1px solid #d1d5db; overflow: hidden; box-sizing: border-box;">
                    <div t-attf-style="padding: 6px 12px; font-weight: 600; border-bottom: 2px solid {{ theme_color }}; color: {{ theme_color }}; font-size: 11px; background: #f9fafb;">
                        <i class="fa fa-university"/> BANKING DETAILS
                    </div>
                    <div style="padding: 10px 14px; min-height: 60px; font-size: 10px; line-height: 1.6; color: #374151;">
                        <t t-if="company.hao_bank_name or company.hao_bank_detail_ids">
                            <t t-if="company.hao_multi_bank and company.hao_bank_detail_ids">
                                <t t-foreach="company.hao_bank_detail_ids" t-as="bank">
                                    <div style="margin-bottom: 3px; color: #111827;">
                                        <i class="fa fa-bank" t-attf-style="margin-right:4px; color: {{ theme_color }};"/>
                                        <span t-field="bank.bank_name"/> — Acc: <strong><span t-field="bank.acc_number"/></strong>
                                        <span t-if="bank.branch"> (<span t-field="bank.branch"/>)</span>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div t-if="company.hao_bank_name" style="margin-bottom:3px;"><strong>Bank:</strong> <span t-field="company.hao_bank_name"/></div>
                                <div t-if="company.hao_bank_account_name" style="margin-bottom:3px;"><strong>Account Name:</strong> <span t-field="company.hao_bank_account_name"/></div>
                                <div t-if="company.hao_bank_account_no"><strong>Account No:</strong> <span t-field="company.hao_bank_account_no"/></div>
                            </t>
                        </t>
                        <t t-else="">
                            <span style="color:#9ca3af; font-style:italic;">No banking details provided.</span>
                        </t>
                    </div>
                    <div t-attf-style="padding: 6px 14px 10px; border-top: 1px dashed #d1d5db; text-align: left; font-weight: 600; font-size: 10.5px; color: {{ theme_color }};">
                        <i t-attf-style="background-color: {{ theme_color }}; color: white; border-radius: 50%; padding: 3px 4px; margin-right: 4px;" class="fa fa-handshake-o"/>
                        Thank you for your business!
                    </div>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!-- FOOTER                                                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <div t-attf-style="background-color: {{ theme_color }}; color: #ffffff; text-align: center; padding: 8px; font-size: 10px; font-weight: 500; border-radius: 2px; letter-spacing: 0.6px; clear: both;">
                <i class="fa fa-bolt" style="margin-right: 4px;"/> Powered by <strong>HavanoERP</strong>
                <t t-if="company.website"> &amp;nbsp;|&amp;nbsp; <span t-field="company.website"/></t>
            </div>

        </div>
    </template>
</odoo>
