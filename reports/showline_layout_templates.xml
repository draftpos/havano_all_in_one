<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_showline">
        <t t-set="doc_model" t-value="o._name"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="theme_color" t-value="'#0a1c40'"/> <!-- Dark Blue -->

        <!-- Inject Poppins font -->
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;900&amp;display=swap');
            .showline-wrap * {
                font-family: 'Poppins', Arial, sans-serif !important;
            }
            .showline-wrap table { border-collapse: collapse; }
            .sl-badge {
                display: inline-block;
                padding: 2px 10px;
                border-radius: 20px;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1px;
                text-transform: uppercase;
            }
            /* Rich-text description: render bullet points and formatting */
            .sl-line-desc ul, .sl-line-desc ol {
                margin: 2px 0 2px 16px;
                padding: 0;
            }
            .sl-line-desc li {
                margin-bottom: 1px;
                list-style-type: disc;
            }
            .sl-line-desc ol li {
                list-style-type: decimal;
            }
            .sl-line-desc p {
                margin: 1px 0;
            }
            .sl-line-desc strong, .sl-line-desc b {
                font-weight: 700;
            }
            .sl-line-desc em, .sl-line-desc i {
                font-style: italic;
            }
        </style>

        <div class="article page showline-wrap" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
             style="font-family: 'Poppins', Arial, sans-serif; font-size: 11px; color: #222; width: 100%; margin: 0; padding: 0;">

            <!-- ══════════════════════════════════════════════ -->
            <!-- HEADER: Logo + Company Info + Doc Title Badge  -->
            <!-- ══════════════════════════════════════════════ -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
                <tr>
                    <!-- LEFT: Logo -->
                    <td style="width: 20%; vertical-align: middle; padding-right: 15px;">
                        <t t-if="company.logo">
                            <img t-att-src="'/web/image/res.company/%s/logo' % company.id"
                                 style="max-height: 70px; max-width: 130px; object-fit: contain;"/>
                        </t>
                    </td>

                    <!-- MIDDLE: Company Details -->
                    <td style="width: 45%; vertical-align: middle; padding-left: 5px;">
                        <div t-attf-style="font-size: 16px; font-weight: 700; color: {{ theme_color }}; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">
                            <span t-field="company.name"/>
                        </div>
                        <div style="font-size: 10px; color: #555; line-height: 1.7;">
                            <t t-if="company.street">
                                <span t-field="company.street"/>
                                <t t-if="company.street2">, <span t-field="company.street2"/></t>
                                <t t-if="company.city">, <span t-field="company.city"/></t>
                                <t t-if="company.country_id">, <span t-field="company.country_id.name"/></t>
                                <br/>
                            </t>
                            <t t-if="company.phone">
                                <i class="fa fa-phone" style="margin-right:4px; color:#0a1c40;"/>
                                <span t-field="company.phone"/>
                                <t t-if="company.email"> &amp;nbsp;|&amp;nbsp; </t>
                            </t>
                            <t t-if="company.email">
                                <i class="fa fa-envelope-o" style="margin-right:4px; color:#0a1c40;"/>
                                <span t-field="company.email"/>
                            </t>
                            <t t-if="company.website">
                                <br/>
                                <i class="fa fa-globe" style="margin-right:4px; color:#0a1c40;"/>
                                <span t-field="company.website"/>
                            </t>
                        </div>
                    </td>

                    <!-- RIGHT: Document Title + TIN/VAT -->
                    <td style="width: 35%; vertical-align: middle; text-align: right;">
                        <div t-attf-style="font-size: 22px; font-weight: 900; letter-spacing: 3px; color: {{ theme_color }}; margin-bottom: 8px;">
                            &#8212;
                            <t t-if="doc_model == 'sale.order'">
                                <t t-if="is_pro_forma">PRO-FORMA</t>
                                <t t-elif="o.state in ['draft', 'sent']">QUOTATION</t>
                                <t t-else="">SALES ORDER</t>
                            </t>
                            <t t-if="doc_model == 'account.move'">
                                <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">INVOICE</t>
                                <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">DRAFT INVOICE</t>
                                <t t-elif="o.move_type == 'out_refund'">CREDIT NOTE</t>
                                <t t-elif="o.move_type == 'in_invoice'">VENDOR BILL</t>
                                <t t-elif="o.move_type == 'in_refund'">VENDOR CREDIT NOTE</t>
                                <t t-else="">DOCUMENT</t>
                            </t>
                            &#8212;
                        </div>
                        <div style="border: 1px solid #0a1c40; padding: 5px 10px; display: inline-block; font-size: 10px; border-radius: 4px; background: #f4f6fb;">
                            <i class="fa fa-id-card-o" style="margin-right: 4px; color: #0a1c40;"/>
                            <strong>TIN:</strong> <span t-esc="company.company_registry or 'N/A'"/>
                            <span style="margin: 0 6px; color:#aaa;">|</span>
                            <strong>VAT:</strong> <span t-esc="company.vat or 'N/A'"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Divider -->
            <div t-attf-style="height: 3px; background: linear-gradient(to right, {{ theme_color }}, #4a6fa5, #d4e0f7); border-radius: 2px; margin-bottom: 18px;"/>

            <!-- ══════════════════════════════════════════════ -->
            <!-- DETAILS ROW: Customer + Invoice Info            -->
            <!-- ══════════════════════════════════════════════ -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
                <tr>
                    <!-- CUSTOMER DETAILS -->
                    <td style="width: 48%; vertical-align: top;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;">
                            <tr>
                                <td colspan="2" t-attf-style="background-color: {{ theme_color }}; color: #fff; font-weight: 600; padding: 7px 12px; font-size: 11px;">
                                    <i class="fa fa-user" style="margin-right: 6px;"/> CUSTOMER DETAILS
                                </td>
                            </tr>
                            <tr style="background: #f8f9fb;">
                                <td style="font-weight: 600; padding: 6px 12px; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; width: 35%; color: #444;">Customer</td>
                                <td style="padding: 6px 12px; border-bottom: 1px solid #dee2e6;"><span t-field="partner.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600; padding: 6px 12px; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; color: #444;">Address</td>
                                <td style="padding: 6px 12px; border-bottom: 1px solid #dee2e6; color: #555;">
                                    <span t-if="partner.street" t-field="partner.street"/>
                                    <span t-if="partner.street2">, <span t-field="partner.street2"/></span>
                                    <span t-if="partner.city">, <span t-field="partner.city"/></span>
                                    <span t-if="partner.country_id">, <span t-field="partner.country_id.name"/></span>
                                </td>
                            </tr>
                            <tr style="background: #f8f9fb;">
                                <td style="font-weight: 600; padding: 6px 12px; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; color: #444;">Phone</td>
                                <td style="padding: 6px 12px; border-bottom: 1px solid #dee2e6;"><span t-esc="partner.phone or 'N/A'"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600; padding: 6px 12px; border-right: 1px solid #dee2e6; color: #444;">VAT / TIN</td>
                                <td style="padding: 6px 12px; color: #555;"><span t-esc="partner.vat or 'N/A'"/></td>
                            </tr>
                        </table>
                    </td>

                    <td style="width: 4%;"/>

                    <!-- INVOICE DETAILS -->
                    <td style="width: 48%; vertical-align: top;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;">
                            <tr>
                                <td colspan="2" t-attf-style="background-color: {{ theme_color }}; color: #fff; font-weight: 600; padding: 7px 12px; font-size: 11px;">
                                    <i class="fa fa-file-text-o" style="margin-right: 6px;"/>
                                    <t t-if="doc_model == 'sale.order'">ORDER DETAILS</t>
                                    <t t-else="">INVOICE DETAILS</t>
                                </td>
                            </tr>
                            <tr style="background: #f8f9fb;">
                                <td style="font-weight: 600; padding: 6px 12px; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; width: 40%; color: #444;">
                                    <t t-if="doc_model == 'sale.order'">Order No.</t>
                                    <t t-else="">Invoice No.</t>
                                </td>
                                <td style="padding: 6px 12px; border-bottom: 1px solid #dee2e6; font-weight: 700;"><span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600; padding: 6px 12px; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; color: #444;">Date</td>
                                <td style="padding: 6px 12px; border-bottom: 1px solid #dee2e6;">
                                    <t t-if="doc_model == 'sale.order'"><span t-field="o.date_order" t-options='{"widget": "date"}'/></t>
                                    <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date" t-options='{"widget": "date"}'/></t>
                                </td>
                            </tr>
                            <tr style="background: #f8f9fb;">
                                <td style="font-weight: 600; padding: 6px 12px; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; color: #444;">Currency</td>
                                <td style="padding: 6px 12px; border-bottom: 1px solid #dee2e6;"><span t-field="o.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: 600; padding: 6px 12px; border-right: 1px solid #dee2e6; color: #444;">
                                    <t t-if="doc_model == 'sale.order'">Salesperson</t>
                                    <t t-else="">Due Date</t>
                                </td>
                                <td style="padding: 6px 12px;">
                                    <t t-if="doc_model == 'sale.order'"><span t-field="o.user_id.name"/></t>
                                    <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date_due" t-options='{"widget": "date"}'/></t>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════ -->
            <!-- LINES TABLE                                     -->
            <!-- ══════════════════════════════════════════════ -->
            <table style="width: 100%; border-collapse: collapse; border: 1px solid #dee2e6; margin-bottom: 18px; border-radius: 6px; overflow: hidden;">
                <thead>
                    <tr t-attf-style="background-color: {{ theme_color }}; color: #fff; font-weight: 600; font-size: 11px;">
                        <th style="padding: 9px 8px; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); width: 5%;">#</th>
                        <th style="padding: 9px 8px; text-align: left; border-right: 1px solid rgba(255,255,255,0.2); width: 43%;">Description</th>
                        <th style="padding: 9px 8px; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); width: 10%;">Qty</th>
                        <th style="padding: 9px 8px; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); width: 15%;">Unit Price (<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="padding: 9px 8px; text-align: center; border-right: 1px solid rgba(255,255,255,0.2); width: 12%;">Tax Amt<br/>(<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="padding: 9px 8px; text-align: center; width: 15%;">Total Amt<br/>(<span t-field="o.currency_id.symbol"/>)</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                    <t t-set="line_count" t-value="1"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type in ['product', False, '']">
                            <tr t-attf-style="border-bottom: 1px solid #dee2e6; background: {{ '#f8f9fb' if line_index % 2 == 0 else '#fff' }};">
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #dee2e6; font-weight: 600; color: #0a1c40;">
                                    <span t-esc="line_count"/>
                                    <t t-set="line_count" t-value="line_count + 1"/>
                                </td>
                                <td style="padding: 8px; text-align: left; border-right: 1px solid #dee2e6;">
                                    <div class="sl-line-desc" t-out="line.name"/>
                                </td>
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #dee2e6;">
                                    <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 1}'/>
                                    <span t-if="doc_model == 'account.move'" t-field="line.quantity" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #dee2e6;">
                                    <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #dee2e6;">
                                    <t t-set="tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                    <span t-esc="tax_amt" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="padding: 8px; text-align: center; font-weight: 600;">
                                    <span t-field="line.price_total" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- ══════════════════════════════════════════════ -->
            <!-- TOTALS ROW                                      -->
            <!-- ══════════════════════════════════════════════ -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 22px;">
                <tr>
                    <td style="width: 52%;"/>
                    <td style="width: 48%;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;">
                            <tr style="background: #f8f9fb;">
                                <td style="padding: 8px 14px; text-align: right; font-weight: 600; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; width: 60%; color: #555;">SUBTOTAL (Excl. Tax)</td>
                                <td style="padding: 8px 14px; text-align: right; border-bottom: 1px solid #dee2e6; font-weight: 500;">
                                    <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 14px; text-align: right; font-weight: 600; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; color: #555;">TOTAL TAX</td>
                                <td style="padding: 8px 14px; text-align: right; border-bottom: 1px solid #dee2e6; font-weight: 500;">
                                    <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-attf-style="background-color: {{ theme_color }}; color: #fff;">
                                <td style="padding: 10px 14px; text-align: right; font-weight: 700; border-right: 1px solid rgba(255,255,255,0.2); font-size: 12px;">TOTAL (Incl. Tax)</td>
                                <td style="padding: 10px 14px; text-align: right; font-weight: 700; font-size: 13px;">
                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════ -->
            <!-- TERMS AND BANKING ROW                          -->
            <!-- ══════════════════════════════════════════════ -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 22px;">
                <tr>
                    <!-- TERMS -->
                    <td style="width: 48%; vertical-align: top; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;">
                        <div t-attf-style="padding: 7px 12px; font-weight: 600; border-bottom: 2px solid {{ theme_color }}; color: {{ theme_color }}; font-size: 11px; background: #f4f6fb;">
                            <i class="fa fa-file-text-o"/> TERMS &amp; CONDITIONS
                        </div>
                        <div style="padding: 12px 16px; min-height: 70px; color: #555; font-size: 10px;">
                            <div t-if="doc_model == 'sale.order' and o.note" t-field="o.note"/>
                            <div t-if="doc_model == 'account.move' and o.narration" t-field="o.narration"/>
                        </div>
                        <div t-attf-style="padding: 8px 16px 10px; border-top: 1px dashed #dee2e6; font-size: 10px; color: #666;">
                            ------------------------------------<br/>
                            <strong>Authorised Signatory</strong><br/>
                            <span t-field="company.name" style="text-transform: uppercase; font-weight: 600;"/>
                        </div>
                    </td>

                    <td style="width: 4%;"/>

                    <!-- BANKING -->
                    <td style="width: 48%; vertical-align: top; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden;">
                        <div t-attf-style="padding: 7px 12px; font-weight: 600; border-bottom: 2px solid {{ theme_color }}; color: {{ theme_color }}; font-size: 11px; background: #f4f6fb;">
                            <i class="fa fa-university"/> BANKING DETAILS
                        </div>
                        <div style="padding: 12px 16px; min-height: 70px; font-size: 10px;">
                            <t t-if="company.hao_bank_name or company.hao_bank_detail_ids">
                                <t t-if="company.hao_multi_bank and company.hao_bank_detail_ids">
                                    <t t-foreach="company.hao_bank_detail_ids" t-as="bank">
                                        <div style="margin-bottom: 4px; color: #222;">
                                            <i class="fa fa-bank" style="margin-right:4px; color:#0a1c40;"/>
                                            <span t-field="bank.bank_name"/> — Acc: <strong><span t-field="bank.acc_number"/></strong>
                                            <span t-if="bank.branch"> (<span t-field="bank.branch"/>)</span>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div t-if="company.hao_bank_name" style="margin-bottom:3px;"><strong>Bank:</strong> <span t-field="company.hao_bank_name"/></div>
                                    <div t-if="company.hao_bank_account_name" style="margin-bottom:3px;"><strong>Account Name:</strong> <span t-field="company.hao_bank_account_name"/></div>
                                    <div t-if="company.hao_bank_account_no"><strong>Account No:</strong> <span t-field="company.hao_bank_account_no"/></div>
                                </t>
                            </t>
                            <t t-else="">
                                <span style="color:#aaa; font-style:italic;">No banking details provided.</span>
                            </t>
                        </div>
                        <div t-attf-style="padding: 8px 16px 10px; border-top: 1px dashed #dee2e6; text-align: left; font-weight: 600; font-size: 11px; color: {{ theme_color }};">
                            <i t-attf-style="background-color: {{ theme_color }}; color: white; border-radius: 50%; padding: 4px 5px; margin-right: 5px;" class="fa fa-handshake-o"/>
                            Thank you for your business!
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ══════════════════════════════════════════════ -->
            <!-- FOOTER                                          -->
            <!-- ══════════════════════════════════════════════ -->
            <div t-attf-style="background: linear-gradient(to right, {{ theme_color }}, #1a3a6e); color: white; text-align: center; padding: 10px; font-size: 10px; border-radius: 4px; letter-spacing: 1px;">
                <i class="fa fa-bolt" style="margin-right: 5px;"/> Powered by <strong>HavanoERP</strong>
                <t t-if="company.website"> &amp;nbsp;|&amp;nbsp; <span t-field="company.website"/></t>
            </div>

        </div>
    </template>
</odoo>
