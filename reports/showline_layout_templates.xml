<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_showline">
        <t t-set="doc_model" t-value="o._name"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="theme_color" t-value="'#0a1c40'"/> <!-- Dark Blue -->
        
        <div class="article page" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" style="font-family: 'Arial', sans-serif; font-size: 12px; color: #000; width: 100%; margin: 0; padding: 0;">
            
            <!-- HEADER -->
            <div style="text-align: center; margin-bottom: 20px;">
                <span t-attf-style="font-weight: 900; font-size: 24px; letter-spacing: 3px; color: {{ theme_color }};">
                    &#8212; 
                    <t t-if="doc_model == 'sale.order'">
                        <t t-if="is_pro_forma">PRO-FORMA INVOICE</t>
                        <t t-elif="o.state in ['draft', 'sent']">QUOTATION</t>
                        <t t-else="">SALES ORDER</t>
                    </t>
                    <t t-if="doc_model == 'account.move'">
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">INVOICE</t>
                        <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">DRAFT INVOICE</t>
                        <t t-elif="o.move_type == 'out_refund'">CREDIT NOTE</t>
                        <t t-elif="o.move_type == 'in_invoice'">VENDOR BILL</t>
                        <t t-elif="o.move_type == 'in_refund'">VENDOR CREDIT NOTE</t>
                        <t t-else="">DOCUMENT</t>
                    </t>
                    &#8212;
                </span>
            </div>

            <!-- COMPANY ROW -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px;">
                <tr>
                    <td style="width: 60%; vertical-align: middle;">
                        <span t-attf-style="font-weight: 900; font-size: 20px; color: {{ theme_color }}; text-transform: uppercase;">
                            <span t-field="company.name"/>
                        </span>
                    </td>
                    <td style="width: 40%; vertical-align: middle; text-align: right;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%;"></td>
                                <td style="border: 1px solid #000; padding: 4px 8px; font-size: 11px; white-space: nowrap;">
                                    <i class="fa fa-file-text-o" style="margin-right: 4px;"></i>
                                    <strong>TIN: </strong><span t-esc="company.company_registry or 'N/A'"/> 
                                    <span style="margin: 0 5px;">|</span>
                                    <strong>VAT No: </strong><span t-esc="company.vat or 'N/A'"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- DETAILS ROW -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                <tr>
                    <!-- CUSTOMER DETAILS -->
                    <td style="width: 48%; vertical-align: top;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #ccc;">
                            <tr>
                                <td colspan="2" t-attf-style="background-color: {{ theme_color }}; color: #fff; font-weight: bold; padding: 6px 10px; font-size: 12px; border: 1px solid {{ theme_color }};">
                                    <i class="fa fa-user" style="margin-right: 5px;"></i> CUSTOMER DETAILS
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc; width: 35%;">Customer Name</td>
                                <td style="padding: 6px 10px; border-bottom: 1px solid #ccc; width: 65%;">: <span t-field="partner.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc;">Address</td>
                                <td style="padding: 6px 10px; border-bottom: 1px solid #ccc;">
                                    : 
                                    <span t-if="partner.street" t-field="partner.street"/><span t-if="partner.street2">, <span t-field="partner.street2"/></span>
                                    <span t-if="partner.city">, <span t-field="partner.city"/></span>
                                    <span t-if="partner.country_id">, <span t-field="partner.country_id.name"/></span>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-right: 1px solid #ccc;">Phone</td>
                                <td style="padding: 6px 10px;">: <span t-esc="partner.phone or partner.mobile or 'N/A'"/></td>
                            </tr>
                        </table>
                    </td>
                    <td style="width: 4%;"></td>
                    <!-- INVOICE DETAILS -->
                    <td style="width: 48%; vertical-align: top;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #ccc;">
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc; width: 35%;">
                                    <t t-if="doc_model == 'sale.order'">Order No.</t>
                                    <t t-else="">Invoice No.</t>
                                </td>
                                <td style="padding: 6px 10px; border-bottom: 1px solid #ccc; width: 65%;">: <span t-field="o.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc;">Date</td>
                                <td style="padding: 6px 10px; border-bottom: 1px solid #ccc;">
                                    : 
                                    <t t-if="doc_model == 'sale.order'"><span t-field="o.date_order" t-options='{"widget": "date"}'/></t>
                                    <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date" t-options='{"widget": "date"}'/></t>
                                </td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc;">Currency</td>
                                <td style="padding: 6px 10px; border-bottom: 1px solid #ccc;">: <span t-field="o.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold; padding: 6px 10px; border-right: 1px solid #ccc;">
                                    <t t-if="doc_model == 'sale.order'">Salesperson</t>
                                    <t t-else="">Due Date</t>
                                </td>
                                <td style="padding: 6px 10px;">
                                    : 
                                    <t t-if="doc_model == 'sale.order'"><span t-field="o.user_id.name"/></t>
                                    <t t-if="doc_model == 'account.move'"><span t-field="o.invoice_date_due" t-options='{"widget": "date"}'/></t>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- LINES TABLE -->
            <table style="width: 100%; border-collapse: collapse; border: 1px solid #ccc; margin-bottom: 20px;">
                <thead>
                    <tr t-attf-style="background-color: {{ theme_color }}; color: #fff; font-weight: bold;">
                        <th style="padding: 8px; text-align: center; border: 1px solid #ccc; width: 5%;">#</th>
                        <th style="padding: 8px; text-align: left; border: 1px solid #ccc; width: 45%;">Description</th>
                        <th style="padding: 8px; text-align: center; border: 1px solid #ccc; width: 10%;">Qty</th>
                        <th style="padding: 8px; text-align: center; border: 1px solid #ccc; width: 15%;">Unit Price (<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="padding: 8px; text-align: center; border: 1px solid #ccc; width: 10%;">Tax Amount<br/>(<span t-field="o.currency_id.symbol"/>)</th>
                        <th style="padding: 8px; text-align: center; border: 1px solid #ccc; width: 15%;">Total Amount<br/>(<span t-field="o.currency_id.symbol"/>)</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                    <t t-set="line_count" t-value="1"/>
                    <t t-foreach="lines" t-as="line">
                        <t t-if="line.display_type in ['product', False, '']">
                            <tr style="border-bottom: 1px solid #ccc;">
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #ccc; font-weight: bold;">
                                    <span t-esc="line_count"/>
                                    <t t-set="line_count" t-value="line_count + 1"/>
                                </td>
                                <td style="padding: 8px; text-align: left; border-right: 1px solid #ccc;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #ccc;">
                                    <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 1}'/>
                                    <span t-if="doc_model == 'account.move'" t-field="line.quantity" t-options='{"widget": "float", "precision": 1}'/>
                                </td>
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #ccc;">
                                    <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="padding: 8px; text-align: center; border-right: 1px solid #ccc;">
                                    <t t-set="tax_amt" t-value="line.price_total - line.price_subtotal"/>
                                    <span t-esc="tax_amt" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td style="padding: 8px; text-align: center;">
                                    <span t-field="line.price_total" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- TOTALS ROW -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                <tr>
                    <td style="width: 50%;"></td>
                    <td style="width: 50%;">
                        <table style="width: 100%; border-collapse: collapse; border: 1px solid #ccc;">
                            <tr>
                                <td style="padding: 8px 15px; text-align: right; font-weight: bold; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc; width: 60%;">SUBTOTAL (Excl. Tax)</td>
                                <td style="padding: 8px 15px; text-align: right; border-bottom: 1px solid #ccc; width: 40%;">
                                    <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 15px; text-align: right; font-weight: bold; border-bottom: 1px solid #ccc; border-right: 1px solid #ccc;">TOTAL TAX</td>
                                <td style="padding: 8px 15px; text-align: right; border-bottom: 1px solid #ccc;">
                                    <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-attf-style="background-color: {{ theme_color }}; color: #fff;">
                                <td style="padding: 8px 15px; text-align: right; font-weight: bold; border-right: 1px solid #fff;">TOTAL (Incl. Tax)</td>
                                <td style="padding: 8px 15px; text-align: right; font-weight: bold;">
                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- TERMS & BANKING ROW -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                <tr>
                    <!-- TERMS & CONDITIONS -->
                    <td style="width: 48%; vertical-align: top; border: 1px solid #ccc;">
                        <div t-attf-style="padding: 8px 10px; font-weight: bold; border-bottom: 1px solid {{ theme_color }}; margin: 0 10px; margin-bottom: 10px; color: {{ theme_color }}; font-size: 13px;">
                            <i class="fa fa-file-text-o"></i> TERMS &amp; CONDITIONS
                        </div>
                        <div style="padding: 10px 20px; height: 80px;">
                            <div t-if="doc_model == 'sale.order' and o.note" t-field="o.note"/>
                            <div t-if="doc_model == 'account.move' and o.narration" t-field="o.narration"/>
                        </div>
                        <div style="padding: 0 20px 10px 20px;">
                            ------------------------------------<br/>
                            <strong>Authorised Signatory</strong><br/>
                            <span t-field="company.name" style="text-transform: uppercase;"/>
                        </div>
                    </td>
                    <td style="width: 4%;"></td>
                    <!-- BANKING DETAILS -->
                    <td style="width: 48%; vertical-align: top; border: 1px solid #ccc;">
                        <div t-attf-style="padding: 8px 10px; font-weight: bold; border-bottom: 1px solid {{ theme_color }}; margin: 0 10px; margin-bottom: 10px; color: {{ theme_color }}; font-size: 13px;">
                            <i class="fa fa-bank"></i> BANKING DETAILS
                        </div>
                        <div style="padding: 10px 20px; height: 80px; font-style: italic; color: #666;">
                            <t t-if="company.hao_bank_name or company.hao_bank_detail_ids">
                                <t t-if="company.hao_multi_bank and company.hao_bank_detail_ids">
                                    <t t-foreach="company.hao_bank_detail_ids" t-as="bank">
                                        <div style="font-style: normal; color: #000;">
                                            <span t-field="bank.bank_name"/> - Acc: <span t-field="bank.acc_number"/>
                                            <span t-if="bank.branch"> (<span t-field="bank.branch"/>)</span>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div t-if="company.hao_bank_name" style="font-style: normal; color: #000;"><strong>Bank: </strong><span t-field="company.hao_bank_name"/></div>
                                    <div t-if="company.hao_bank_account_name" style="font-style: normal; color: #000;"><strong>Account Name: </strong><span t-field="company.hao_bank_account_name"/></div>
                                    <div t-if="company.hao_bank_account_no" style="font-style: normal; color: #000;"><strong>Account No: </strong><span t-field="company.hao_bank_account_no"/></div>
                                </t>
                            </t>
                            <t t-else="">
                                No banking details provided.
                            </t>
                        </div>
                        <div style="padding: 0 20px 10px 20px; text-align: left; font-weight: bold; font-size: 13px;">
                            <i t-attf-style="background-color: {{ theme_color }}; color: white; border-radius: 50%; padding: 5px; margin-right: 5px;" class="fa fa-handshake-o"></i>
                            <span t-attf-style="color: {{ theme_color }};">Thank you for your business!</span>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- FOOTER -->
            <div t-attf-style="background-color: {{ theme_color }}; color: white; text-align: center; padding: 10px; font-size: 12px; margin-top: 20px;">
                Powered by HavanoERP
            </div>
            
        </div>
    </template>
</odoo>
