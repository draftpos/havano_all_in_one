<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_template_report_showline">
        <t t-set="doc_model" t-value="o._name"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id"/>
        <t t-set="accent_color" t-value="company.hao_document_layout_id.base_color or '#c07d38'"/>

        <div class="article page" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 12px; color: #222222; width: 100%; line-height: 1.45;">

            <!-- ================= HEADER SECTION ================= -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                <tr>
                    <!-- Top-Left: Company Logo, Name & Address -->
                    <td style="width: 50%; vertical-align: top; padding-right: 15px;">
                        <div t-if="company.logo" style="margin-bottom: 8px;">
                            <img t-att-src="image_data_uri(company.logo)" style="max-height: 75px; max-width: 200px; object-fit: contain;" alt="Company Logo"/>
                        </div>
                        <div style="font-weight: bold; font-size: 14px; color: #111111; margin-bottom: 3px;" t-field="company.name"/>
                        <div style="color: #555555; font-size: 11px; line-height: 1.4;">
                            <div t-if="company.street" t-field="company.street"/>
                            <div t-if="company.street2" t-field="company.street2"/>
                            <div>
                                <span t-if="company.city" t-field="company.city"/>
                                <span t-if="company.state_id">, <span t-field="company.state_id.name"/></span>
                                <span t-if="company.zip"> <span t-field="company.zip"/></span>
                            </div>
                            <div t-if="company.country_id" t-field="company.country_id.name"/>
                        </div>
                    </td>

                    <!-- Top-Right: Boxed Company Details Card -->
                    <td style="width: 50%; vertical-align: top; padding-left: 15px;">
                        <div style="border: 1px solid #d5d5d5; border-radius: 6px; padding: 12px 15px; background-color: #fbfbfb; font-size: 11px; line-height: 1.55; color: #333333; min-height: 95px;">
                            <t t-if="company.company_details">
                                <div t-field="company.company_details"/>
                            </t>
                            <t t-else="">
                                <div t-if="company.phone"><strong>Phone: </strong><span t-field="company.phone"/></div>
                                <div t-if="company.email"><strong>Email: </strong><span t-field="company.email"/></div>
                                <div t-if="company.website"><strong>Website: </strong><span t-field="company.website"/></div>
                                <div t-if="company.vat"><strong>VAT No: </strong><span t-field="company.vat"/></div>
                                <div t-if="company.company_registry"><strong>TIN / Reg No: </strong><span t-field="company.company_registry"/></div>
                            </t>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ================= CUSTOMER DETAILS SECTION ================= -->
            <div style="margin-top: 15px; margin-bottom: 22px; width: 55%; font-size: 12px; line-height: 1.45; color: #333333;">
                <div style="font-weight: bold; font-size: 14px; color: #111111; margin-bottom: 4px;" t-field="partner.name"/>
                
                <div style="color: #444444;">
                    <div t-if="partner.street" t-field="partner.street"/>
                    <div t-if="partner.street2" t-field="partner.street2"/>
                    <div>
                        <span t-if="partner.city" t-field="partner.city"/>
                        <span t-if="partner.state_id">, <span t-field="partner.state_id.name"/></span>
                        <span t-if="partner.zip"> <span t-field="partner.zip"/></span>
                    </div>
                    <div t-if="partner.country_id" t-field="partner.country_id.name"/>
                </div>

                <div style="margin-top: 4px; color: #444444;">
                    <div t-if="partner.phone or partner.mobile">
                        <strong>Phone: </strong><span t-esc="partner.phone or partner.mobile"/>
                    </div>
                    <div t-if="partner.email">
                        <strong>Email: </strong><span t-field="partner.email"/>
                    </div>
                    <div t-if="partner.vat or getattr(partner, 'hao_vat', False)">
                        <strong>VAT: </strong><span t-esc="partner.vat or getattr(partner, 'hao_vat', False)"/>
                    </div>
                    <div t-if="partner.company_registry or getattr(partner, 'hao_tin', False)">
                        <strong>TIN: </strong><span t-esc="partner.company_registry or getattr(partner, 'hao_tin', False)"/>
                    </div>
                </div>
            </div>

            <!-- ================= DOCUMENT TITLE ================= -->
            <div style="margin-top: 10px; margin-bottom: 16px;">
                <h2 t-attf-style="margin: 0; font-size: 24px; font-weight: bold; color: {{ accent_color }}; letter-spacing: -0.3px;">
                    <t t-if="doc_model == 'sale.order'">
                        <t t-if="is_pro_forma">Pro-Forma Invoice # <span t-field="o.name"/></t>
                        <t t-elif="o.state in ['draft', 'sent']">Quotation # <span t-field="o.name"/></t>
                        <t t-else="">Sales Order # <span t-field="o.name"/></t>
                    </t>
                    <t t-if="doc_model == 'account.move'">
                        <t t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice # <span t-field="o.name"/></t>
                        <t t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice # <span t-field="o.name"/></t>
                        <t t-elif="o.move_type == 'out_refund'">Credit Note # <span t-field="o.name"/></t>
                        <t t-elif="o.move_type == 'in_invoice'">Vendor Bill # <span t-field="o.name"/></t>
                        <t t-elif="o.move_type == 'in_refund'">Vendor Credit Note # <span t-field="o.name"/></t>
                        <t t-else="">Document # <span t-field="o.name"/></t>
                    </t>
                </h2>
            </div>

            <!-- ================= METADATA ROW ================= -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                <tr>
                    <!-- Col 1: Date -->
                    <td style="width: 30%; vertical-align: top;">
                        <div style="font-weight: bold; font-size: 12px; color: #111111; margin-bottom: 3px;">
                            <t t-if="doc_model == 'sale.order'">
                                <t t-if="o.state in ['draft', 'sent']">Quotation Date</t>
                                <t t-else="">Order Date</t>
                            </t>
                            <t t-else="">Invoice Date</t>
                        </div>
                        <div style="font-size: 12px; color: #444444;">
                            <t t-if="doc_model == 'sale.order'">
                                <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </t>
                            <t t-if="doc_model == 'account.move'">
                                <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                            </t>
                        </div>
                    </td>

                    <!-- Col 2: Expiration / Due Date -->
                    <td style="width: 30%; vertical-align: top;">
                        <div style="font-weight: bold; font-size: 12px; color: #111111; margin-bottom: 3px;">
                            <t t-if="doc_model == 'sale.order'">Expiration</t>
                            <t t-else="">Due Date</t>
                        </div>
                        <div style="font-size: 12px; color: #444444;">
                            <t t-if="doc_model == 'sale.order'">
                                <span t-if="o.validity_date" t-field="o.validity_date" t-options='{"widget": "date"}'/>
                                <span t-elif="o.payment_term_id" t-field="o.payment_term_id.name"/>
                                <span t-else="">—</span>
                            </t>
                            <t t-if="doc_model == 'account.move'">
                                <span t-if="o.invoice_date_due" t-field="o.invoice_date_due" t-options='{"widget": "date"}'/>
                                <span t-elif="o.invoice_payment_term_id" t-field="o.invoice_payment_term_id.name"/>
                                <span t-else="">—</span>
                            </t>
                        </div>
                    </td>

                    <!-- Col 3: Salesperson -->
                    <td style="width: 40%; vertical-align: top;">
                        <div style="font-weight: bold; font-size: 12px; color: #111111; margin-bottom: 3px;">
                            Salesperson
                        </div>
                        <div style="font-size: 12px; color: #444444;">
                            <t t-if="doc_model == 'sale.order'">
                                <span t-field="o.user_id.name"/>
                            </t>
                            <t t-if="doc_model == 'account.move'">
                                <span t-if="o.invoice_user_id" t-field="o.invoice_user_id.name"/>
                                <span t-elif="o.user_id" t-field="o.user_id.name"/>
                                <span t-else="">—</span>
                            </t>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- ================= LINE ITEMS TABLE ================= -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
                <thead>
                    <tr style="border-bottom: 1px solid #111111;">
                        <th style="padding: 8px 6px; text-align: left; font-weight: bold; font-size: 12px; color: #111111; width: 50%;">Description</th>
                        <th style="padding: 8px 6px; text-align: right; font-weight: bold; font-size: 12px; color: #111111; width: 18%;">Quantity</th>
                        <th style="padding: 8px 6px; text-align: right; font-weight: bold; font-size: 12px; color: #111111; width: 16%;">Unit Price</th>
                        <th style="padding: 8px 6px; text-align: right; font-weight: bold; font-size: 12px; color: #111111; width: 16%;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.invoice_line_ids if doc_model == 'account.move' else o.order_line"/>
                    <t t-foreach="lines" t-as="line">
                        <!-- Section -->
                        <t t-if="line.display_type == 'line_section'">
                            <tr style="background-color: #f7f7f7; font-weight: bold;">
                                <td colspan="4" style="padding: 8px 6px; color: #111111;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <!-- Note -->
                        <t t-elif="line.display_type == 'line_note'">
                            <tr style="font-style: italic; color: #666666;">
                                <td colspan="4" style="padding: 6px;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <!-- Standard Product Line -->
                        <t t-elif="line.display_type in ['product', False, '']">
                            <tr style="border-bottom: 1px solid #f2f2f2;">
                                <td style="padding: 9px 6px; text-align: left; vertical-align: top; color: #222222;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="padding: 9px 6px; text-align: right; vertical-align: top; color: #333333; white-space: nowrap;">
                                    <span t-if="doc_model == 'sale.order'" t-field="line.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/>
                                    <span t-if="doc_model == 'account.move'" t-field="line.quantity" t-options='{"widget": "float", "precision": 2}'/>
                                    <span t-if="line.product_uom_id" style="color: #666666; margin-left: 2px;" t-field="line.product_uom_id.name"/>
                                </td>
                                <td style="padding: 9px 6px; text-align: right; vertical-align: top; color: #333333; white-space: nowrap;">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="padding: 9px 6px; text-align: right; vertical-align: top; font-weight: 500; color: #111111; white-space: nowrap;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- Divider Line Above Totals -->
            <div style="border-top: 1px solid #111111; width: 100%; margin-top: 4px; margin-bottom: 16px;"></div>

            <!-- ================= TOTALS & SUMMARY ================= -->
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
                <tr>
                    <!-- Left: Notes / Bank Details -->
                    <td style="width: 55%; vertical-align: top; padding-right: 20px;">
                        <!-- Payment terms & Notes -->
                        <div t-if="doc_model == 'sale.order' and o.note" style="margin-bottom: 12px; font-size: 11px; color: #555555;">
                            <strong>Note: </strong><span t-field="o.note"/>
                        </div>
                        <div t-if="doc_model == 'account.move' and o.narration" style="margin-bottom: 12px; font-size: 11px; color: #555555;">
                            <strong>Note: </strong><span t-field="o.narration"/>
                        </div>

                        <!-- Bank Details -->
                        <t t-if="company.hao_bank_name or company.hao_bank_detail_ids">
                            <div style="font-size: 11px; line-height: 1.45; color: #444444; border-left: 2px solid #e0e0e0; padding-left: 10px; margin-top: 10px;">
                                <div style="font-weight: bold; color: #222222; margin-bottom: 2px;">Banking Details:</div>
                                <t t-if="company.hao_multi_bank and company.hao_bank_detail_ids">
                                    <t t-foreach="company.hao_bank_detail_ids" t-as="bank">
                                        <div>
                                            <span t-field="bank.bank_name"/> - Acc: <span t-field="bank.acc_number"/>
                                            <span t-if="bank.branch"> (<span t-field="bank.branch"/>)</span>
                                            <span t-if="bank.currency_id"> [<span t-field="bank.currency_id.name"/>]</span>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div t-if="company.hao_bank_name"><strong>Bank: </strong><span t-field="company.hao_bank_name"/></div>
                                    <div t-if="company.hao_bank_account_name"><strong>Account Name: </strong><span t-field="company.hao_bank_account_name"/></div>
                                    <div t-if="company.hao_bank_account_no"><strong>Account No: </strong><span t-field="company.hao_bank_account_no"/></div>
                                    <div t-if="company.hao_bank_branch"><strong>Branch: </strong><span t-field="company.hao_bank_branch"/></div>
                                    <div t-if="company.hao_bank_swift_code"><strong>Swift: </strong><span t-field="company.hao_bank_swift_code"/></div>
                                </t>
                            </div>
                        </t>
                    </td>

                    <!-- Right: Subtotal, Taxes, Total -->
                    <td style="width: 45%; vertical-align: top;">
                        <table style="width: 100%; border-collapse: collapse; line-height: 1.6;">
                            <t t-if="o.amount_tax &gt; 0">
                                <tr>
                                    <td style="padding: 3px 6px; text-align: right; color: #555555; font-size: 12px;">Subtotal</td>
                                    <td style="padding: 3px 6px; text-align: right; font-weight: 500; font-size: 12px; color: #222222; width: 45%;">
                                        <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 3px 6px; text-align: right; color: #555555; font-size: 12px;">Taxes</td>
                                    <td style="padding: 3px 6px; text-align: right; font-weight: 500; font-size: 12px; color: #222222;">
                                        <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td style="padding: 6px; text-align: right; font-weight: bold; font-size: 15px; color: #111111;">Total</td>
                                <td t-attf-style="padding: 6px; text-align: right; font-weight: bold; font-size: 15px; color: {{ accent_color }};">
                                    <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

        </div>
    </template>
</odoo>
