<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_havano_financial_ratio_tree" model="ir.ui.view">
        <field name="name">havano.financial.ratio.tree</field>
        <field name="model">havano.financial.ratio</field>
        <field name="arch" type="xml">
            <list string="Financial Ratios" create="false" edit="false" delete="false">
                <field name="name" string="Ratio Name" optional="show"/>
                <field name="category" string="Category" optional="hide"/>
                <field name="value" string="Calculated Value" widget="badge" decoration-success="True" optional="show"/>
                <field name="create_date" string="Calculation Date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_havano_financial_ratio_search" model="ir.ui.view">
        <field name="name">havano.financial.ratio.search</field>
        <field name="model">havano.financial.ratio</field>
        <field name="arch" type="xml">
            <search string="Financial Ratios">
                <field name="name"/>
                <field name="category"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('create_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('create_date', '&gt;=', context_today().replace(day=1).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                    <filter string="Calculation Date" name="group_by_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Root Menu for Financial Ratios -->
    <record id="menu_hao_financial_ratios_root" model="ir.ui.menu">
        <field name="name">Financial Ratios</field>
        <field name="parent_id" ref="account.account_reports_management_menu"/>
        <field name="sequence">150</field>
        <field name="active" eval="False"/>
    </record>

    <!-- Investment Ratios Server Action & Menu -->
    <record id="action_investment_ratios" model="ir.actions.server">
        <field name="name">Investment Ratios</field>
        <field name="model_id" ref="model_havano_financial_ratio"/>
        <field name="state">code</field>
        <field name="code">
res = model.action_compute_and_open_ratios('inv')
res['view_mode'] = 'list'
action = res
        </field>
    </record>
    <record id="menu_hao_financial_ratios_inv" model="ir.ui.menu">
        <field name="name">Investment Ratios</field>
        <field name="parent_id" ref="menu_hao_financial_ratios_root"/>
        <field name="action" ref="action_investment_ratios"/>
        <field name="sequence">10</field>
    </record>

