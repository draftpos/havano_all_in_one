<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="hao_profit_and_loss" model="account.report">
        <field name="name">Custom Profit and Loss</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="sequence">999</field> <!-- Handled by dynamic routing -->
        <field name="filter_date_range" eval="True"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="allow_account_audit_status_on_lines" eval="True"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="column_ids">
            <record id="hao_profit_and_loss_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="hao_account_financial_report_revenue0" model="account.report.line">
                <field name="name">Revenue</field>
                <field name="sequence">10</field>
                <field name="code">HAO_REV</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_revenue0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income'), ('account_id.hao_custom_category', 'not in', ('investing', 'financing', 'discontinued'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_cost_sales0" model="account.report.line">
                <field name="name">Less Cost of Sales</field>
                <field name="sequence">20</field>
                <field name="code">HAO_COS</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_cost_sales0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost'), ('account_id.hao_custom_category', 'not in', ('investing', 'financing', 'discontinued'))]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_gross_profit0" model="account.report.line">
                <field name="name">Gross Profit</field>
                <field name="sequence">30</field>
                <field name="code">HAO_GRP</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_gross_profit0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">HAO_REV.balance - HAO_COS.balance</field>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_other_income0" model="account.report.line">
                <field name="name">Other Income</field>
                <field name="sequence">40</field>
                <field name="code">HAO_OIN</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_other_income0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income_other'), ('account_id.hao_custom_category', 'not in', ('investing', 'financing', 'discontinued'))]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_expense0" model="account.report.line">
                <field name="name">Less Operating Expenses</field>
                <field name="sequence">50</field>
                <field name="code">HAO_EXP</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_expense0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense'), ('account_id.hao_custom_category', 'not in', ('investing', 'financing', 'discontinued'))]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_depreciation0" model="account.report.line">
                <field name="name">Less Other Expenses</field>
                <field name="sequence">60</field>
                <field name="code">HAO_OEXP</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_depreciation0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ('expense_depreciation', 'expense_other')), ('account_id.hao_custom_category', 'not in', ('investing', 'financing', 'discontinued'))]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_investing_expenses0" model="account.report.line">
                <field name="name">Less Investing Expenses</field>
                <field name="sequence">61</field>
                <field name="code">HAO_INV</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_investing_expenses0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <!-- Assuming investing expenses are debits, we sum them as positive expenses to subtract later, if they are credits (income), -sum. We'll use sum for expenses. -->
                        <field name="formula" eval="[('account_id.hao_custom_category', '=', 'investing')]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_financing_expenses0" model="account.report.line">
                <field name="name">Less Financing Expenses</field>
                <field name="sequence">62</field>
                <field name="code">HAO_FIN</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_financing_expenses0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.hao_custom_category', '=', 'financing')]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_continuing_ops0" model="account.report.line">
                <field name="name">Profit from Continuing Operations</field>
                <field name="sequence">63</field>
                <field name="code">HAO_CONT</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_continuing_ops0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">HAO_REV.balance + HAO_OIN.balance - HAO_COS.balance - HAO_EXP.balance - HAO_OEXP.balance - HAO_INV.balance - HAO_FIN.balance</field>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_discontinued_ops0" model="account.report.line">
                <field name="name">Gain/Loss from Discontinued Operations</field>
                <field name="sequence">64</field>
                <field name="code">HAO_DISC</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_discontinued_ops0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <!-- Assuming gain is positive, we use -sum (credit is positive). If they are mostly expenses, sum. But 'Gain/Loss' implies standard credit=positive convention. -->
                        <field name="formula" eval="[('account_id.hao_custom_category', '=', 'discontinued')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="hao_account_financial_report_net_profit0" model="account.report.line">
                <field name="name">Net Profit</field>
                <field name="sequence">70</field>
                <field name="hierarchy_level">0</field>
                <field name="code">HAO_NEP</field>
                <field name="expression_ids">
                    <record id="hao_account_financial_report_net_profit0_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">HAO_CONT.balance + HAO_DISC.balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
